# ─── Orchestrator Agent — Okta AI Agent (A0_XAA) ─────────────────
# Handles cross-IdP identity federation (Steps 1–2).
# Authenticates at Okta Org AS to request ID-JAGs on behalf of users.
# See README.md → Setup → steps A and C.
OKTA_DOMAIN=your-org.okta.com
OKTA_CLIENT_ID=your_okta_ai_agent_client_id
OKTA_CLIENT_SECRET=your_okta_ai_agent_client_secret
OKTA_AUDIENCE=api://default

# ─── Auth0 (Resource Authorization Server) ────────────────────────
# jwt-bearer conduit credentials (Step 3). Regular Web App in Auth0.
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_API_AUDIENCE=https://your-api-identifier/
AUTH0_CLIENT_ID=your_auth0_requesting_party_client_id
AUTH0_CLIENT_SECRET=your_auth0_requesting_party_client_secret
AUTH0_CONNECTION=your_auth0_enterprise_connection_name
AUTH0_API_SCOPE=openid

# ─── Okta Resource Authorization Server ───────────────────────────
OKTA_RESOURCE_AS_ISSUER=https://your-org.okta.com/oauth2/your-resource-as-id

# ─── Observer Agent — Auth0 Agent Object (agt_xxx) ────────────────
# Named principal in the final token (act.sub). Handles Step 3.5 OBO exchange.
# See README.md → Setup → steps G, H, and I.

# Agent object ID — Auth0 Dashboard → AI Agents → your agent → Agent ID
AUTH0_AGENT_ID=agt_xxxxxxxxxxxxxxxxxxxx

# M2M Custom API Client for OBO token exchange (Step 3.5).
# Must be created from the API page. Token-exchange grant must be enabled.
# Must be linked to the agent object above.
AUTH0_AGENT_CLIENT_ID=your_observer_agent_m2m_client_id
AUTH0_AGENT_CLIENT_SECRET=your_observer_agent_m2m_client_secret
