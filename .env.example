# ─── Okta (Client / IdP) ─────────────────────────────────────────
OKTA_DOMAIN=your-org.okta.com
OKTA_CLIENT_ID=your_okta_agent_client_id
OKTA_CLIENT_SECRET=your_okta_agent_client_secret
OKTA_AUDIENCE=api://default

# ─── Auth0 (Resource Server) ──────────────────────────────────────
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_API_AUDIENCE=https://your-api-identifier/
AUTH0_CLIENT_ID=your_auth0_app_client_id
AUTH0_CLIENT_SECRET=your_auth0_app_client_secret
AUTH0_CONNECTION=your_auth0_enterprise_connection_name
AUTH0_API_SCOPE=openid

# ─── Okta Resource Authorization Server ───────────────────────────
OKTA_RESOURCE_AS_ISSUER=https://your-org.okta.com/oauth2/your-resource-as-id

# ─── Agent as a Principal (Auth0) ─────────────────────────────────
# See README.md → Setup → steps H and I for how to create these via the Auth0 dashboard.

# Agent object ID — Auth0 Dashboard → AI Agents → your agent → Agent ID
AUTH0_AGENT_ID=agt_xxxxxxxxxxxxxxxxxxxx

# M2M Custom API Client for OBO token exchange (Step 3.5).
# Must be created from the API page (Machine to Machine Applications tab).
# Must have token-exchange grant type enabled. Must be linked to the agent object.
AUTH0_AGENT_CLIENT_ID=your_agent_m2m_client_id
AUTH0_AGENT_CLIENT_SECRET=your_agent_m2m_client_secret
